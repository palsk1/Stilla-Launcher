<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the long-press menu open Android's own uninstall dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- A short buzz in "only remind" mode. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The app watcher: which app is in front ("Usage access")... -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- ...and the right to put the "how long?" card in front of it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Swipe down on home pulls down the notifications (fallback when the watcher is off). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- See every app that has a launcher entry (no QUERY_ALL_PACKAGES needed). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Which apps are web browsers: they are never blocked as a whole. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- No INTERNET permission, on purpose: nothing Stilla sees can leave the phone. -->

    <application
        android:name=".StillaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stilla">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize|stateHidden">

            <!-- This is what makes Stilla a home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Lets Android Studio's Run button start it, and shows it in other launchers. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Optional "Notification access": only so home can show the song that's
             playing and control it. It never reads, hides or changes notifications. -->
        <service
            android:name=".media.MediaListener"
            android:exported="false"
            android:label="@string/media_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The "how long?", blocked and time's-up cards: their own small screen,
             opened on top of whatever app is in front and closed once answered. -->
        <activity
            android:name=".guard.GuardActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="se.stilla.launcher.cards"
            android:windowSoftInputMode="stateAlwaysHidden" />

    </application>
</manifest>
